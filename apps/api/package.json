{
  "name": "@gulumsalim/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:categories": "tsx ../../infra/postgres/seed/seed-categories.ts",
    "db:seed:admin": "tsx ../../infra/postgres/seed/seed-admin.ts",
    "db:seed:settings": "tsx ../../infra/postgres/seed/seed-settings.ts",
    "db:seed:pages": "tsx ../../infra/postgres/seed/seed-pages.ts",
    "reindex:products": "tsx ../../infra/postgres/seed/reindex-products.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/session": "^11.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.8",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fast-xml-parser": "^5.2.5",
    "fastify-type-provider-zod": "^4.0.2",
    "google-auth-library": "^11.0.0",
    "ioredis": "^5.4.1",
    "iyzipay": "^2.0.53",
    "meilisearch": "^0.59.0",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "resend": "^6.18.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
