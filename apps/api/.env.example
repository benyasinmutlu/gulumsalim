NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://gulumsalim:changeme@localhost:5432/gulumsalim

REDIS_URL=redis://localhost:6379

SESSION_SECRET=changeme-32-char-minimum-secret-value

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=changeme

DISCOVERY_SERVICE_URL=http://localhost:8081
DISCOVERY_SERVICE_SECRET=changeme

# Satıcıların Trendyol/İkas/Ticimax API bilgilerini AES-256-GCM ile
# şifrelemek için 32 baytlık rastgele anahtar (64 hex karakter önerilir).
# Bu anahtarı değiştirmek eski bağlantıları okunamaz hale getirir.
INTEGRATIONS_ENC_KEY=
# Gelen kanal webhook'ları için paylaşılan secret; boşsa webhook fail-closed.
INTEGRATIONS_WEBHOOK_SECRET=

# Resmi XML/CSV/JSON feed scheduler kapasitesi. Tek instance varsayilan olarak
# her 15 saniyede en fazla 4 farkli kaynagi DB lease ile claim eder.
MERCHANT_FEED_POLL_INTERVAL_MS=15000
MERCHANT_FEED_BATCH_SIZE=4

IYZICO_API_KEY=sandbox-changeme
IYZICO_SECRET_KEY=sandbox-changeme
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

SITE_URL=http://localhost:3001
# Ayrı bir Next.js dev origin'i veya ek canonical domain gerekiyorsa virgülle
# ayırın. Prod'da güvenilmeyen/wildcard origin eklemeyin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

UPLOADS_DIR=./uploads

RESEND_API_KEY=re_changeme
SMTP_FROM=Gülüm Şalım <info@gulumsalim.com>

# Google ile giriş - Google Cloud Console'da oluşturulan OAuth 2.0 Client ID
# (web uygulaması türü). apps/web/.env.local.example'daki
# NEXT_PUBLIC_GOOGLE_CLIENT_ID ile aynı değer olmalı. Boş bırakılırsa özellik
# devre dışı kalır.
GOOGLE_CLIENT_ID=

# Opsiyonel ürün açıklaması/kategori/nitelik önerileri. Anahtar yoksa sistem
# deterministik kural tabanlı önerilere düşer. Model yalnız sunucu env'sinden
# seçilir; istemci model seçemez.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_API_KEY=
AI_MODEL=qwen/qwen3.5-flash-02-23
AI_MAX_PROMPT_PRICE_PER_M=0.20
AI_MAX_COMPLETION_PRICE_PER_M=1.00
AI_MAX_CONCURRENT_REQUESTS=4
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=30000
