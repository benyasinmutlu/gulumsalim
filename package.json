{
  "name": "gulumsalim",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "postman-request@2.88.1-postman.51>qs": "6.16.1",
      "postman-request@2.88.1-postman.51>uuid": "11.1.1",
      "exceljs@4.4.0>uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev:api": "pnpm --filter @gulumsalim/api dev",
    "dev:web": "pnpm --filter @gulumsalim/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @gulumsalim/web lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @gulumsalim/api db:migrate",
    "test": "pnpm --filter @gulumsalim/api test",
    "security:smoke": "bash infra/scripts/security-smoke.sh"
  }
}
